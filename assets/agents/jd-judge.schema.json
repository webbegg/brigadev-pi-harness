{
	"type": "object",
	"additionalProperties": false,
	"description": "Initial discovery: findings only. Scoped re-judgment: resolutions only.",
	"properties": {
		"findings": {
			"type": "array",
			"description": "Initial discovery: candidate findings; [] when clean.",
			"items": {
				"type": "object",
				"required": ["id", "severity", "location", "claim", "evidence"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "minLength": 1, "description": "JD-A-001 or JD-B-001 style, by judge." },
					"severity": { "type": "string", "enum": ["BLOCKER", "CRITICAL", "WARNING", "SUGGESTION"] },
					"location": { "type": "string", "minLength": 1, "description": "path/to/file.ts:LINE" },
					"claim": { "type": "string", "minLength": 1, "description": "Concrete user-impact claim." },
					"evidence": { "type": "string", "minLength": 1, "description": "Changed hunk or reproduction." }
				}
			}
		},
		"resolutions": {
			"type": "array",
			"description": "Scoped re-judgment: one outcome per frozen ID.",
			"items": {
				"type": "object",
				"required": ["id", "outcome", "evidence"],
				"additionalProperties": false,
				"properties": {
					"id": { "type": "string", "minLength": 1 },
					"outcome": { "type": "string", "enum": ["verified", "corroborated", "regression"], "description": "verified = fixed, corroborated = still present, regression = the fix broke something." },
					"evidence": { "type": "string", "minLength": 1 }
				}
			}
		}
	}
}
